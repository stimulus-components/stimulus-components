{
  "private": true,
  "scripts": {
    "lint": "pnpm lint:check && pnpm lint:js",
    "lint:check": "tsc --noEmit",
    "lint:js": "eslint .",
    "lintfix": "prettier --write --list-different . && pnpm lint:js --fix",
    "docs": "pnpm -C docs dev",
    "test": "vitest --run",
    "build:components": "pnpm --filter \"./components/*\" run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:components && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.13",
    "@nuxt/eslint-config": "^1.16.0",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/google.maps": "^3.65.4",
    "@types/rails__request.js": "^0.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
