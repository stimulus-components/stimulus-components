{
  "private": true,
  "scripts": {
    "lint": "pnpm lint:check && pnpm lint:js",
    "lint:check": "tsc --noEmit",
    "lint:js": "eslint .",
    "lintfix": "prettier --write --list-different . && pnpm lint:js --fix",
    "docs": "pnpm -C docs dev",
    "test": "vitest --run",
    "build:components": "pnpm --filter \"./components/*\" run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:components && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.13",
    "@nuxt/eslint-config": "^1.15.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/dom-speech-recognition": "^0.0.11",
    "@types/google.maps": "^3.58.1",
    "@types/rails__request.js": "^0.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.3"
}
