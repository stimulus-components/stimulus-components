{
  "name": "@stimulus-components/scroll-reveal",
  "version": "4.0.1",
  "description": "A Stimulus controller that animates an element when it becomes visible.",
  "keywords": [
    "stimulus",
    "stimulusjs",
    "stimulus controller",
    "scroll reveal",
    "reveal"
  ],
  "repository": "git@github.com:stimulus-components/stimulus-components.git",
  "bugs": {
    "url": "https://github.com/stimulus-components/stimulus-components/issues"
  },
  "author": "Guillaume Briday <guillaumebriday@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/stimulus-components/stimulus-components",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/stimulus-scroll-reveal.umd.js",
  "module": "dist/stimulus-scroll-reveal.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/stimulus-scroll-reveal.mjs",
      "require": "./dist/stimulus-scroll-reveal.umd.js"
    },
    "./src": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "types": "tsc --noEmit false --declaration true --emitDeclarationOnly true --rootDir src --outDir dist/types",
    "dev": "vite",
    "build": "vite build && pnpm run types",
    "version": "pnpm build",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
